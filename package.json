{
  "name": "pos-pci",
  "private": true,
  "version": "0.1.0",
  "description": "POS Ecosystem — Mobile POS, Web Outlet, Web Admin, Backend API",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev:api": "pnpm --filter backend-api dev",
    "dev:admin": "pnpm --filter web-admin dev",
    "dev:outlet": "pnpm --filter web-outlet dev",
    "dev:mobile": "pnpm --filter mobile-pos start",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint"
  }
}
